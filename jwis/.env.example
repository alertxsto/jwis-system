# JWIS environment configuration (copy to .env; never commit real secrets)

# CORS: comma-separated list of allowed frontend origins
JWIS_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Role login passwords (pilot-grade demo defaults are "<role>-demo-pass").
# Override each role in real deployments:
JWIS_PW_EXECUTIVE=
JWIS_PW_DISPATCHER=
JWIS_PW_SUPERVISOR=
JWIS_PW_DRIVER=
JWIS_PW_AUDITOR=
JWIS_PW_ADMINISTRATOR=

# OpenWA WhatsApp gateway (leave blank to keep alerts honestly unsent)
OPENWA_BASE_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# OpenAI for the assistant (optional; falls back to local responder)
OPENAI_API_KEY=

# Background AI engine (auto-reroute, TPA queue predictor, event forecast).
# The Windows launchers set this to "on"; without it every /api/ai/* endpoint
# returns empty. Set to "on" for demos, "off" keeps tests deterministic.
JWIS_AI_ENGINE=on
