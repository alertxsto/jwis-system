index 0000000..0b49489
--- /dev/null
+++ b/jwis/frontend/src/ui/SegmentedControl.jsx
@@ -0,0 +1,22 @@
+import React from "react";
+
+export function SegmentedControl({ label, describedBy, value, options, onChange }) {
+  return (
+    <div className="segmented-control" role="group" aria-label={label} aria-describedby={describedBy}>
+      {options.map((option) => (
+        <button
+          key={option.value}
+          type="button"
+          aria-pressed={value === option.value}
+          disabled={option.disabled}
+          title={option.title}
+          onClick={() => {
+            if (!option.disabled) onChange(option.value);
+          }}
+        >
+          {option.label}
+        </button>
+      ))}
+    </div>
+  );
+}
