# Python cache / virtualenv
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Node / Vite dependency and build cache
node_modules/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Runtime SQLite (regenerated at runtime)
jwis_history.db
*.db-journal

# --- Secrets & runtime artifacts (MUST NOT be committed) ---

# Environment files with real credentials
.env
.env.*
!.env.example

# Backend boot / smoke logs
*.log

# WhatsApp (Baileys) session credentials — regenerated at runtime via QR scan
jwis/backend/wa-gateway/baileys_auth_info/

# Playwright artifacts
test-results/
playwright-report/

